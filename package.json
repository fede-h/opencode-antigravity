{
  "name": "open-gemini",
  "version": "1.0.0",
  "description": "Local OpenAI-compatible proxy bridge and automated installer to route Google Antigravity models (Gemini 3.8 Flash, Gemini 4 Argon, Claude 5.5 Thinking, GPT-OSS 120B) to OpenCode CLI and Desktop.",
  "module": "src/server.ts",
  "bin": {
    "open-gemini": "./src/server.ts",
    "open-gemini-setup": "./src/scripts/setup-opencode.ts",
    "open-gemini-quota": "./src/scripts/show-quota.ts"
  },
  "type": "module",
  "scripts": {
    "setup": "bun run src/scripts/setup-opencode.ts",
    "quota": "bun run src/scripts/show-quota.ts",
    "start": "bun run src/server.ts",
    "dev": "bun run --watch src/server.ts",
    "lint:check": "bun x tsc --noEmit --skipLibCheck",
    "test": "bun test tests/unit",
    "reset-accounts": "bun run src/scripts/reset-accounts.ts"
  },
  "dependencies": {
    "bun": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
